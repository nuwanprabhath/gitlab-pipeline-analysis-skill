# Config for the unattended nightly pipeline report (automation/nightly_report.sh).
# Copy to config.env in the same folder and edit. Shell syntax; no spaces around `=`.
# config.env is gitignored, so `git pull` never clobbers your settings.

# --- what to analyze ---------------------------------------------------------

# GitLab project the pipeline belongs to.
PROJECT="ternandsparrow/paratoo-fdcp"

# Where the .xlsx deliverables and run logs are written. Must be a stable folder:
# the skill's "New failure" comparison finds the previous run by looking here.
OUT_DIR="$HOME/pipeline-reports"

# --- how to find the nightly pipeline ----------------------------------------

# trigger_window : newest pipeline started by TRIGGER_USER inside the overnight
#                  hour window (the usual case for a scheduled nightly run)
# ref            : newest pipeline on a ref; REF may be exact ("dev") or a
#                  prefix ending in * ("dev/*")
# schedule_id    : newest pipeline created by a specific GitLab CI/CD schedule
DETECTION_MODE="trigger_window"

# --- trigger_window mode ---
TRIGGER_USER="tomantonic"
# Local-time hours; the window may wrap midnight (23 -> 2 means 11pm-2am).
WINDOW_START_HOUR="23"
WINDOW_END_HOUR="2"

# --- ref mode ---
REF="dev/*"

# --- schedule_id mode ---
# Find it in GitLab under CI/CD > Schedules (the id in the schedule's URL).
SCHEDULE_ID=""

# How many recent pipelines to scan when looking for a match (paged 100 at a
# time). ref mode and a trigger_window with no TRIGGER_USER filter client-side,
# so they need a big budget — MR pipelines crowd out the nightly otherwise.
SCAN_COUNT="300"

# Refuse to analyze a match older than this many hours — catches "the nightly
# didn't run" instead of silently re-reporting a stale pipeline. 0 disables.
MAX_AGE_HOURS="24"

# Skip the run if this pipeline's .xlsx already exists in OUT_DIR (so a retry or
# a doubled-up cron entry doesn't redo work). Set to "no" to always re-analyze.
SKIP_IF_ALREADY_ANALYZED="yes"

# --- Claude ------------------------------------------------------------------

# Claude model to use. Empty = whatever your Claude Code default is.
CLAUDE_MODEL=""

# Extra flags passed verbatim to `claude -p` (e.g. "--verbose").
CLAUDE_EXTRA_ARGS=""

# Delete run logs older than this many days (0 keeps them forever).
LOG_RETENTION_DAYS="30"

# --- tool locations (only if auto-detection fails) ---------------------------

# The runner searches PATH plus the usual install dirs (~/.local/bin, ~/bin,
# /opt/homebrew/bin, /usr/local/bin, /usr/bin, /bin, /snap/bin), which covers
# Homebrew on both Apple Silicon and Intel, apt, snap and npm global installs.
# If a tool lives somewhere else, give its absolute path here — the containing
# directory is added to PATH, so child processes find it too. Leave empty
# otherwise; the error message names the key to set if one goes missing.
CLAUDE_BIN=""
GLAB_BIN=""
PYTHON_BIN=""

# --- desktop notifications ---------------------------------------------------

# Send a desktop notification when the analysis starts (pipeline number, date
# and time) and when it finishes (unique failure count, HIGH count, new-failure
# count, elapsed time). Failures notify at critical urgency. Needs `notify-send`
# (Ubuntu: sudo apt install libnotify-bin) and a logged-in graphical session —
# if either is missing, notifications are skipped and the run still completes.
NOTIFY="yes"

# Icon name or absolute path shown on the notification.
NOTIFY_ICON="utilities-terminal"
